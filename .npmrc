# LOAD-BEARING. Do not delete this file as "redundant defaults".
#
# onnxruntime-node's postinstall consults an install manifest keyed by
# platform. Every platform requires nothing EXCEPT linux/x64, which
# defaults to ["cuda12"] and pulls Microsoft.ML.OnnxRuntime.Gpu.Linux
# from nuget.org - libonnxruntime_providers_cuda.so,
# libonnxruntime_providers_tensorrt.so and libonnxruntime_providers_shared.so.
#
# That is hundreds of MB of GPU execution providers. Vercel functions
# have no GPU; SCRFD runs on the CPU binaries already bundled in the npm
# package, so the download is pure dead weight against the 250MB limit.
#
# It never reproduces on macOS or Windows, because darwin/* and win32/*
# require [] - it only appears on the Linux build machine.
#
# Both keys are set on purpose: `-install=skip` is the current flag, and
# `-install-cuda=skip` is its deprecated predecessor, still honoured.
# package.json allows ^1.20.1, so a resolve could land on either era.
onnxruntime-node-install=skip
onnxruntime-node-install-cuda=skip

# Also load-bearing, and learned the hard way.
#
# pnpm caches the FILES A POSTINSTALL PRODUCED, keyed by package and
# platform, and replays them on a later install without re-running the
# script. So a store populated before the skip above existed keeps
# handing back the CUDA providers forever - the setting looks ignored,
# and CI restoring that store made the fix appear not to work at all.
#
# Turning it off costs nothing here: sharp and onnxruntime-node ship
# prebuilt binaries and compile nothing, so their scripts are cheap.
side-effects-cache=false
