# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Safe to expose to the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server only. Bypasses RLS - never expose to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key, used by the vision-model judged axes
# (background, attire, expression, solo). Server only.
ANTHROPIC_API_KEY=
