# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Safe to expose to the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server only. Bypasses RLS and keys the rate-limit
# IP HMAC - never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key, used by the vision-model judged axes
# (background, attire, expression, solo). Server only.
ANTHROPIC_API_KEY=

# Pexels API key, used ONLY by training/collect-corpus.ts to build the
# labelling corpus. Free, no approval: https://www.pexels.com/api/
# Never needed by the app at runtime, and never at build time.
PEXELS_API_KEY=
