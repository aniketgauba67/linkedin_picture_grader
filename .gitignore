# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Test output
coverage/

# Environment
.env
.env.*
!.env.example

# Training data is never committed, and neither is the model corpus.
# `data/*` rather than `data/`, for the same reason as `models/*` below:
# git cannot re-include a file whose PARENT DIRECTORY is excluded, so a
# bare `data/` would make the negation silently do nothing and the
# provenance record would never be committed.
data/*
# The exception. manifest.csv holds no pixels - it is the record of where
# every image came from, under what licence, and who took it. Losing it
# means a corpus nobody can prove the provenance of.
!data/manifest.csv
# Same reasoning for the validation set's provenance, and the same
# two-step shape it needs: re-include the directory, exclude its
# contents, then name the files that are records rather than pixels.
# The Wikimedia images carry per-file licences including ShareAlike, so
# sources.csv is the only thing that makes redistribution checkable.
!data/validation/
data/validation/*
!data/validation/sources.csv
!data/validation/labels.csv
!data/validation/README.md
# The hand-labels. 500 rows of human judgement that cannot be
# regenerated from anything - losing them means relabelling 125 images.
!data/validation/calibration-labels.csv
# `models/*` rather than `models/`: git cannot re-include a file whose
# PARENT DIRECTORY is excluded, so a bare `models/` would make the
# negations below silently do nothing - and `git add -A` would skip the
# model without a word.
models/*
# One exception, allowed explicitly rather than by weakening the rule:
# the face detector weights. A pinned 2.4MB weight file is a different
# thing from training images - it is required to build, it never grows,
# and it is stored through Git LFS. Its hash is pinned in
# models/manifest.json and checked on install.
!models/det_500m.onnx
!models/manifest.json

# The one committed image, for the same reason: a single 45KB
# public-domain portrait that proves the detector loads and fires.
# Everything else image-shaped stays out.
!packages/features/fixtures/
!packages/features/fixtures/portrait.jpg

# Supabase local stack
supabase/.branches/
supabase/.temp/

