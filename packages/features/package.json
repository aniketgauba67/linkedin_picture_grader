{
  "name": "@pps/features",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "//": "Node only. sharp needs libvips and onnxruntime-node needs a native addon, so nothing here can run in a Supabase Edge Function. Extraction runs once per image in a Vercel Node function and caches to Postgres.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@pps/schema": "workspace:*",
    "@pps/scoring": "workspace:*",
    "heic-convert": "^2.1.0",
    "onnxruntime-node": "^1.20.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/heic-convert": "^2.1.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
