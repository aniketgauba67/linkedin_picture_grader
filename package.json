{
  "name": "profile-photo-scorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:turbo": "turbo run test",
    "eval": "pnpm --silent --filter @pps/eval build && node packages/eval/dist/cli.js",
    "corpus": "pnpm --silent --filter @pps/training build && node --env-file-if-exists=.env.local training/dist/collect-corpus.js",
    "calibrate": "pnpm --silent --filter @pps/training build && node training/dist/calibrate.js",
    "dataset": "pnpm --silent --filter @pps/training build && node --env-file-if-exists=.env.local training/dist/dataset.js",
    "offline-label": "pnpm --silent --filter @pps/training build && node --env-file-if-exists=.env.local training/dist/offline-cli.js",
    "reextract": "pnpm --silent --filter @pps/training build && node training/dist/reextract.js",
    "clean": "turbo run clean && rm -rf node_modules",
    "postinstall": "node scripts/check-lfs.mjs && node scripts/verify-models.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
  "verify:trace": "node scripts/check-trace.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "sharp"
    ]
  }
}
